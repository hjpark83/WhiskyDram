# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 로그인 리다이렉트에 쓰여요. 로컬은 http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI — 셋 중 하나만 있어도 동작해요.
#   AI_PROVIDER 로 강제 지정할 수 있고, 없으면 키가 있는 것 중
#   anthropic → openai → gemini 순서로 골라요.
#   아무 키도 없으면 규칙 기반 폴백으로 동작해요 (기능은 다 열려 있어요).
# ---------------------------------------------------------------------------
# AI_PROVIDER=anthropic   # anthropic | openai | gemini

# Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# ChatGPT (OpenAI) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5

# Gemini — https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
